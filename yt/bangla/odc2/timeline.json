     115.06135500000008,
     117.12398100000007
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 14,
   "text": "Potem zabiera ich limuzyną na wycieczkę po wieży. A sam patrzy, który z handlarzy połknie haczyk najmocniej.",
   "t0": 117.624,
   "t1": 124.821,
