     106.55222100000005,
     110.70735500000005
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 13,
   "text": "Ale sza. Jak ludzie się dowiedzą, będzie afera. Dlatego wszystko jest tajne.",
