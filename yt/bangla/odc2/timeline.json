     127.23860700000004,
     132.99372300000005
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 16,
   "text": "Handlarz zadaje dużo pytań. Coś mu nie pasuje. I tu Lustig robi najbardziej genialną rzecz w tej historii.",
   "t0": 133.494,
   "t1": 140.984,
