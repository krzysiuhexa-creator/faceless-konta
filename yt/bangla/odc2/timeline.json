     27.661279999999998
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 5,
   "text": "Victor Lustig urodził się w 1890 roku w Austro-Węgrzech, w miasteczku, które dziś leży w Czechach. Przynajmniej tak twierdził. Bo z Lustigiem nigdy nic nie było pewne.",
   "t0": 28.591,
   "t1": 40.884,
   "map": [
    [
     0,
     71,
     28.591279999999998,
     33.436679999999996
