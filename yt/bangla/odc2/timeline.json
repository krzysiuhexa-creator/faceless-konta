     120.85898100000009,
     124.82060700000007
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 15,
   "text": "Wybiera jednego: nowego w Paryżu, trochę niepewnego siebie, który bardzo chce dołączyć do wielkich graczy.",
   "t0": 125.751,
   "t1": 132.994,
   "map": [
