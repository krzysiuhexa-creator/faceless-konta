     38.147279999999995,
     40.883892
    ]
   ],
   "mode": "interp (3z/4k)"
  },
  {
   "id": 6,
   "text": "Używał dziesiątek nazwisk. Kazał się nazywać hrabią. Mówił w kilku językach i ubierał się jak milioner.",
   "t0": 41.384,
   "t1": 48.48,
   "map": [
