     53.746568999999994,
     55.881925
    ]
   ],
   "mode": "interp (2z/3k)"
  },
  {
   "id": 8,
   "text": "Jest maj 1925 roku. Lustig czyta w Paryżu gazetę. Artykuł mówi, że utrzymanie Wieży Eiffla kosztuje majątek.",
   "t0": 56.812,
   "t1": 67.064,
