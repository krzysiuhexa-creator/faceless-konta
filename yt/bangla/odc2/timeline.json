     45.08349199999999,
     48.480069
    ]
   ],
   "mode": "zdania"
  },
  {
   "id": 7,
   "text": "Policja w aktach podawała, że naprawdę nazywał się Robert Miller. Ale nawet tego do końca nie wiadomo.",
   "t0": 48.98,
   "t1": 55.882,
   "map": [
    [
     0,
